{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge card",
  "description": "YAML front matter of kb/<domain>/cards/<arxiv_id>.md. Enforced by validate_card.py. A card that does not validate does not exist.",
  "type": "object",
  "required": [
    "arxiv_id", "title", "date", "domain", "problem", "setting", "method",
    "mathematical_objects", "contribution", "limitations", "open_questions", "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "arxiv_id": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$" },
    "title":    { "type": "string", "minLength": 5 },
    "date":     { "type": "string", "format": "date" },
    "domain":   { "enum": ["stats", "probability", "compbio_methods", "compbio_mechanism", "math"] },

    "problem":      { "type": "string", "minLength": 20, "description": "What question is being answered" },
    "setting":      { "type": "string", "minLength": 20, "description": "Data regime, assumptions, asymptotics" },
    "method":       { "type": "string", "minLength": 20, "description": "The actual technique" },
    "contribution": { "type": "string", "minLength": 20 },

    "mathematical_objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "The load-bearing field. Everything downstream is built from it.",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": false,
        "properties": {
          "name":    { "type": "string", "minLength": 3, "description": "Canonical theory-level name" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "role":    { "type": "string", "minLength": 10,
                       "description": "What work the object does here. 'used in the paper' is not a role." },
          "named_in_paper": { "type": "boolean", "default": true },
          "evidence": { "type": "string",
                        "description": "REQUIRED when named_in_paper is false. Textual anchor for the identification." }
        },
        "allOf": [{
          "if":   { "required": ["named_in_paper"],
                    "properties": { "named_in_paper": { "const": false } } },
          "then": { "required": ["evidence"] }
        }]
      }
    },

    "limitations":       { "type": "array", "minItems": 1, "items": { "type": "string" },
                           "description": "At least one. A card with no limitations was not read carefully." },
    "open_questions":    { "type": "array", "items": { "type": "string" } },
    "cross_domain_note": { "type": "string" },
    "confidence":        { "enum": ["high", "medium", "low"] },
    "sections_read":     { "type": "array", "items": { "type": "string" } }
  }
}
